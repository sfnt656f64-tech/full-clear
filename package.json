{
  "name": "full-clear",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:legacy": "node scripts/legacy/extract-fixtures.mjs",
    "sync": "node scripts/sync-ddragon.ts",
    "live": "node scripts/riot/live.ts",
    "stats": "tsx scripts/riot/stats.ts",
    "desktop:build": "node scripts/desktop/build.ts",
    "desktop": "node scripts/desktop/build.ts && electron .",
    "desktop:dist": "node scripts/desktop/build.ts && electron-builder --win nsis",
    "site:meta": "tsx scripts/site-meta.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Simulateur de build pour Kayn, avec une application de bureau (draft et overlay en jeu).",
  "build": {
    "appId": "io.github.kayn-sim",
    "productName": "Full Clear",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/dist/**/*",
      "!desktop/dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/dist/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Full Clear",
      "artifactName": "FullClear-Setup-${version}.${ext}",
      "include": "desktop/installer.nsh",
      "runAfterFinish": true
    }
  }
}
