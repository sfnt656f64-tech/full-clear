# Copie ce fichier en .env (jamais commité) et remplis-le.
# Clé personnelle Riot (developer.riotgames.com). Ne la colle jamais ailleurs que dans .env.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Ton Riot ID, au format Nom#TAG.
RIOT_ID=
# Routage (EUW) : europe pour account-v1 et match-v5, euw1 pour spectator-v5.
RIOT_REGION=europe
RIOT_PLATFORM=euw1
# Adresse du site ouvert par npm run live (par défaut : la version publiée).
# SITE_URL=https://sfnt656f64-tech.github.io/kayn-sim/
